# ─── Base ─────────────────────────────────────────────────────────────────────
APP_URL=https://envirotrack.uk
NEXT_PUBLIC_APP_URL=https://envirotrack.uk

# ─── Base de données (Neon PostgreSQL) ────────────────────────────────────────
# URL pooler (pgbouncer) pour le runtime
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?pgbouncer=true&connection_limit=1
# URL directe (non-poolée) pour prisma migrate deploy
DIRECT_URL=postgresql://user:password@ep-xxx-direct.neon.tech/neondb

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_min_32_chars_random_string_here
ENCRYPTION_KEY=changeme_32_bytes_base64_encoded==

# Cookies
COOKIE_PREFIX=app
COOKIE_DOMAIN=envirotrack.uk

# Rate limits (optionnel — valeurs par défaut dans le code)
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_SIGNUP_RATE_LIMIT_MAX=5
# AUTH_FORGOT_RATE_LIMIT_MAX=3
# AUTH_RESEND_RATE_LIMIT_MAX=3
# AUTH_RESET_RATE_LIMIT_MAX=5
# AUTH_VERIFY_RATE_LIMIT_MAX=10
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_DURATION_MIN=15
# AUTH_VERIFICATION_TTL_MIN=15
# AUTH_PASSWORD_MIN_LENGTH=8
# AUTH_RATE_LIMIT_FAIL_CLOSED=1   # 1 = fail closed si Redis absent (recommandé prod)
# PASSWORD_HIBP_CHECK=1           # 1 = vérifie Have I Been Pwned

# ─── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=changeme_random_secret_for_cron_auth

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=EnviroTrack <noreply@envirotrack.uk>
ADMIN_CONTACT_EMAIL=contact@envirotrack.uk
# EMAIL_JOB_RETENTION_DAYS=30   # durée de rétention des EmailJob SENT

# ─── Redis (Upstash) — rate-limit, leader-lease, sessions ─────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxx

# ─── Stockage média (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx
CLOUDINARY_UPLOAD_PRESET=envirotrack_docs
# UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png
# UPLOAD_MAX_BYTES=20971520   # 20 MB

# ─── Paiements ────────────────────────────────────────────────────────────────

# FedaPay (Mobile Money principal : Wave, Orange, Moov, MTN — Togo/UEMOA)
# Préfixe : sk_live_ (prod) ou sk_sandbox_ (test)
FEDAPAY_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Moneroo (fallback Mobile Money)
MONEROO_SECRET_KEY=pvk_live_xxxxxxxxxxxxxxxxxxxx
MONEROO_WEBHOOK_SECRET=sk-xxxxxxxxxxxxxxxxxxxx

# PayTech (cartes Visa/Mastercard FCFA)
PAYTECH_API_KEY=xxxxxxxxxxxxxxxxxxxx
PAYTECH_API_SECRET=xxxxxxxxxxxxxxxxxxxx
PAYTECH_IPN_URL=https://envirotrack.uk/api/webhooks/paytech

# Bictorys (dernier recours — désactivé si BICTORYS_API_KEY absent)
# BICTORYS_API_URL=https://api.bictorys.com
# BICTORYS_API_KEY=bct_xxxxxxxxxxxxxxxxxxxx
# BICTORYS_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
# BICTORYS_WEBHOOK_REPLAY_WINDOW_MS=60000

# ─── OAuth Google (Sign in with Google) ───────────────────────────────────────
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://envirotrack.uk/api/auth/oauth/google/callback

# ─── IA / Extraction documentaire ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ─── Données réglementaires (Apify) ───────────────────────────────────────────
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
# APIFY_ACTOR_ANGE=your_actor_id
# APIFY_ACTOR_JO=your_actor_id
# APIFY_ACTOR_MERF=your_actor_id
# APIFY_URL_ANGE=https://...
# APIFY_URL_JO=https://...
# APIFY_URL_MERF=https://...

# IUCN_API_TOKEN=xxxxxxxxxxxxxxxxxxxx   # API IUCN Red List

# ─── Observabilité (Sentry) ───────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=envirotrack

# ─── Dev / Tests ──────────────────────────────────────────────────────────────
# SMOKE_BYPASS_WEBHOOK_VERIFY=1   # Désactive vérif HMAC en smoke tests
